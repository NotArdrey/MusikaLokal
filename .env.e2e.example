E2E_SUPABASE_URL=https://your-e2e-project-ref.supabase.co
E2E_SUPABASE_ANON_KEY=your-e2e-anon-key
# Use either a modern Supabase project secret key or the legacy service_role key.
E2E_SUPABASE_SECRET_KEY=your-e2e-secret-or-service-role-key
# E2E_SUPABASE_SERVICE_ROLE_KEY=your-e2e-service-role-key
E2E_ADMIN_EMAIL=e2e+admin@musikalokal.test
E2E_ADMIN_PASSWORD=change-this-e2e-admin-password
E2E_MOBILE_APP_ID=com.anonymous.musikalokal
E2E_WEB_BASE_URL=http://localhost:8082
EXPO_PUBLIC_E2E=1

# .env.e2e is preferred. The E2E runner can also fall back to a root .env when
# it contains a dedicated non-production Supabase URL plus SUPABASE_SECRET_KEY or
# SUPABASE_SERVICE_ROLE_KEY.
# It will still refuse the protected project ref aefldxegsvzecshlayza.
#
# Dangerous one-off bypass for the protected project guard:
# E2E_DANGEROUS_ALLOW_PROTECTED_PROJECT=I_UNDERSTAND_E2E_CAN_MODIFY_DATA_IN_aefldxegsvzecshlayza
