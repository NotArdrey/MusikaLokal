# Copy to .env.member-verification.local before uploading to Supabase.
# Never commit the local file or real AWS credentials.
AWS_REGION=ap-southeast-2
AWS_REKOGNITION_COLLECTION_ID=musikalokal-members-dev
AWS_REKOGNITION_VIDEO_BUCKET=musikalokal-rekognition-dev-92826
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set only when the runtime credentials are temporary.
AWS_SESSION_TOKEN=

# Optional member-verification tuning.
AWS_FACE_MATCH_THRESHOLD=
AWS_FACE_MATCH_AMBIGUITY_DELTA=1
AWS_REKOGNITION_MAX_VIDEO_BYTES=262144000
AWS_REKOGNITION_POLL_ATTEMPTS=5
# Supabase Storage is allowed automatically through SUPABASE_URL.
MEMBER_VERIFICATION_ALLOWED_MEDIA_HOSTS=
