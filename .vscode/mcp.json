{
	"servers": {
		"com.supabase/mcp": {
			"type": "stdio",
			"command": "npx",
				"args": [
					"@supabase/mcp-server-supabase@0.6.2",
					"--project-ref",
					"aefldxegsvzecshlayza",
					"--read-only",
					"--features",
					"database,storage", 
					"--api-url",
					"https://aefldxegsvzecshlayza.supabase.co"
				],
			"env": {
				"SUPABASE_ACCESS_TOKEN": "sbp_329b45d4f523b89b05bc579dbf5a7383ac4f5238"
			},
			"gallery": "https://api.mcp.github.com",
			"version": "0.6.2"
		}
	},
	"inputs": [
		{
			"id": "project-ref",
