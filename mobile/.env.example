# Consolidated to project root .env
# DO NOT EDIT - variables are managed in the repository root .env
# Kept keys as examples:
EXPO_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
EXPO_PUBLIC_GROQ_API_KEY=

# Server-side Edge Function keys (use secrets in Supabase or CI)
GROQ_API_KEY=
GROQ_FALLBACK_API_KEY=
# Optional Edge Function overrides for consent-gated gig portfolio reviews.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_REVIEW_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_SPEECH_MODEL=whisper-large-v3-turbo
# Face++ Compare settings stay in Supabase Edge Function secrets.
# Never prefix these with EXPO_PUBLIC_ or VITE_.
FACEPP_API_KEY=
FACEPP_API_SECRET=
FACEPP_API_BASE_URL=https://api-us.faceplusplus.com
FACEPP_THRESHOLD_TIER=1e-5
FACEPP_TIMEOUT_MS=20000
FACEPP_MAX_CONCURRENCY_RETRIES=3
FACEPP_RETRY_BASE_DELAY_MS=1000
FACE_GROUP_MAX_MEMBERS=8
# Comma-separated additional Supabase/custom storage hosts allowed for AI review.
AI_REVIEW_ALLOWED_MEDIA_HOSTS=
GEMINI_API_KEY=
OPENAI_API_KEY=
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
ACRCLOUD_MIN_SCORE=80
# Private custom-content bucket used to compare gig audio with playlist recordings.
ACRCLOUD_CONSOLE_TOKEN=
ACRCLOUD_CUSTOM_BUCKET_ID=
ACRCLOUD_CUSTOM_HOST=
ACRCLOUD_CUSTOM_ACCESS_KEY=
ACRCLOUD_CUSTOM_ACCESS_SECRET=
