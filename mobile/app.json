{
  "expo": {
    "name": "musika-lokal",
    "slug": "musika-lokal",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/images/musika-lokal-logo-modern-wordmark.png",
    "scheme": "musikalokal",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0F172A",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.musikalokal",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "CADisableMinimumFrameDurationOnPhone": true,
        "NSLocationWhenInUseUsageDescription": "Allow MusikaLokal to use your location to help pin addresses.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "musikalokal"
            ]
          }
        ]
      }
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-image",
      "expo-video",
      [
        "expo-notifications",
        {
          "defaultChannel": "musika-lokal-alerts-v2"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow MusikaLokal to access your microphone for video verification.",
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow MusikaLokal to use your location to help pin addresses."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/musika-lokal-logo-modern-wordmark.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/musika-lokal-logo-modern-wordmark-dark.png",
            "backgroundColor": "#0F172A"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MusikaLokal to access your camera to take profile photos and verify your identity.",
          "microphonePermission": "Allow MusikaLokal to access your microphone for video verification."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "android": {
      "versionCode": 8,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/musika-lokal-logo-modern-wordmark-dark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.musikalokal",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "musikalokal"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "http"
            },
            {
              "scheme": "https"
            },
            {
              "host": "musika-lokal.vercel.app",
              "path": "/feed"
            },
            {
              "host": "musika-lokal.vercel.app",
              "path": "/home"
            },
            {
              "host": "musika-lokal.vercel.app",
              "path": "/group_details"
            },
            {
              "host": "musika-lokal.vercel.app",
              "path": "/profile"
            },
            {
              "host": "musika-lokal.vercel.app",
              "path": "/production_team"
            },
            {
              "host": "musika-lokal.vercel.app",
              "path": "/product_details"
            },
            {
              "host": "musika-lokal.vercel.app",
              "path": "/playlist_details"
            },
            {
              "host": "musika-lokal.vercel.app",
              "path": "/recovery"
            },
            {
              "host": "musika-lokal.vercel.app",
              "path": "/action"
            }
          ]
        }
      ]
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
