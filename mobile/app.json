{
  "expo": {
    "name": "musika-lokal",
    "slug": "musika-lokal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "musikalokal",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0F172A",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.musikalokal",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "CADisableMinimumFrameDurationOnPhone": true,
        "NSLocationWhenInUseUsageDescription": "Allow MusikaLokal to use your location to help pin addresses.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "musikalokal"
            ]
          }
        ]
      }
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow MusikaLokal to use your location to help pin addresses."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/musika-lokal-logo-modern-wordmark.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A",
          "dark": {
            "backgroundColor": "#0F172A"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MusikaLokal to access your camera to take profile photos and verify your identity.",
          "microphonePermission": "Allow MusikaLokal to access your microphone for video verification."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.musikalokal",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "musikalokal"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
